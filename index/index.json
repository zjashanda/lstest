  "workflows": [
    {
      "workflow_id": "wf.lstest.profile-admission",
      "steps": [
        "load profile",
        "fixture",
        "preflight"
      ],
      "entry": "python -u scripts/lstest.py preflight --profile profiles/<project>/profile.json [--device-snapshot <json>]"
    },
    {
      "workflow_id": "wf.lstest.init-smoke",
      "steps": [
        "preflight",
        "init",
        "smoke"
      ],
      "entry": "python -u scripts/lstest.py smoke --profile profiles/<project>/profile.json --hardware"
    },
    {
      "workflow_id": "wf.lstest.wake-command",
      "steps": [
        "preflight",
        "play 语料",
        "adapter 提交 RawLogRecord",
        "assertions 判定",
        "render summary"
      ],
      "entry": "项目运行入口 + adapters/<project>/case_plan.py（仓库不提供统一 run 子命令）",
      "note": "case 期望值只来自 cases/；缺时间戳规则只能 SKIP"
    },
    {
      "workflow_id": "wf.lstest.online-duplex",
      "steps": [
        "preflight",
        "加载 online packs",
        "多轮执行",
        "coverage 判定",
        "summary"
      ],
      "entry": "项目运行入口 + cases/packs/online-*.json"
    },
    {
      "workflow_id": "wf.lstest.false-wake",
      "steps": [
        "preflight",
        "静默窗口",
        "event_absent 判定"
      ],
      "entry": "项目运行入口 + cases/packs/false-wake.json"
    },
    {
      "workflow_id": "wf.lstest.stability-soak",
      "steps": [
        "preflight",
        "多轮循环",
        "异常隔离",
        "统计与收尾"
      ],
      "entry": "项目运行入口 + 截止时长/停止条件",
      "note": "长跑必须声明停止条件；单轮失败不退出任务"
    },
    {
      "workflow_id": "wf.lstest.audio-material",
      "steps": [
        "tts 合成",
        "校验 WAV",
        "audio scan/play"
      ],
      "entry": "python -u scripts/lstest.py tts --text-file <txt> --output <wav>；python -u scripts/lstest.py audio play --file <wav>"
    },
    {
      "workflow_id": "wf.lstest.serial-evidence",
      "steps": [
        "采集原始行",
        "eventlog build/verify",
        "渲染 tool.log/summary"
      ],
      "entry": "python -u scripts/lstest.py eventlog verify --run-dir <dir> --check-files"
    },
    {
      "workflow_id": "wf.lstest.result-orchestration",
      "steps": [
        "result audit",
        "result migrate（默认 dry-run）",
        "result manifest/readme"
      ],
      "entry": "python -u scripts/lstest.py result audit --run-dir <dir>；python -u scripts/lstest.py result manifest --run-dir <dir>"
    },
    {
      "workflow_id": "wf.lstest.state-coverage",
      "steps": [
        "state list/check",
        "profile-coverage",
        "coverage 判定"
      ],
      "entry": "python -u scripts/lstest.py state profile-coverage --events <events.jsonl>"
    },
    {
      "workflow_id": "wf.lstest.ota-upgrade",
      "steps": [
        "（缺口）OTA 执行",
        "轮次统计",
        "报告"
      ],
      "entry": "未提供；仓库只剩方法文档，tools/ota/*.py 未迁入",
      "status": "gap"
    }
  ],
  "validators": [
    {
      "validator_id": "assertions",
      "file": "scripts/assertions.py",
      "rules": [
        "event_exists",
        "event_within_ms",
        "event_order",
        "event_absent",
        "event_not_during",
        "sequence",
        "duration",
        "response",
        "count_range",
        "state_required",
        "no_reboot"
      ],
      "note": "缺时间戳的时序规则只能 SKIP"
    },
    {
      "validator_id": "coverage",
      "file": "scripts/coverage.py",
      "outputs": [
        "BLOCKED",
        "COVERAGE_DEGRADED"
      ]
    },
    {
      "validator_id": "attribution",
      "file": "scripts/attribution.py",
      "note": "项目私有因果规则由参数传入，不写死引擎"
    },
    {
      "validator_id": "eventlog-verify",
      "file": "scripts/eventlog.py",
      "note": "schema、序号、重算一致、判定冲突、路径泄漏"
    },
    {
      "validator_id": "states",
      "file": "scripts/states.py",
      "note": "状态目录、扩展校验、覆盖率"
    },
    {
      "validator_id": "adapter-guard",
      "file": "scripts/adapter_guard.py",
      "note": "禁止适配层解析/写结果"
    }
  ],
