{
  "schema_version": 1,
  "profile_id": "example-device",
  "ports": [
    {
      "role": "csk",
      "capabilities": ["offline_wake", "offline_asr", "player"]
    },
    {
      "role": "upper",
      "capabilities": ["online_asr", "online_nlp", "tts"]
    }
  ],
  "initialization_patterns": [{
    "pattern": "algo\\s+ready",
    "roles": ["csk"],
    "phases": ["initialization", "smoke_initialization"],
    "debounce_ms": 500,
    "fixtures": {
      "positive": ["algo ready"],
      "negative": ["algo not ready"],
      "segmented": [["algo ", "ready"]]
    }
  }],
  "restart_patterns": [{
    "pattern": "unexpected\\s+reboot",
    "roles": ["csk"],
    "phases": ["restart"],
    "debounce_ms": 1000,
    "fixtures": {"positive": ["unexpected reboot"], "negative": ["reboot request accepted"]}
  }],
  "recovery": {
    "initialization_timeout_s": 10.0,
    "restart_poll_interval_s": 0.1,
    "stable_for_s": 1.0,
    "stop_on_failure": false
  },
  "commands": [
    {
      "command": "project-defined initialization command",
      "roles": ["csk"],
      "safe_init": false,
      "success_patterns": ["project-defined success acknowledgement"],
      "evidence_patterns": ["project-defined post-command evidence"],
      "retries": 1,
      "timeout_s": 3.0,
      "evidence_timeout_s": 3.0,
      "retry_delay_s": 0.2
    }
  ],
  "correlation": {
    "id": "project-defined",
    "fields": ["queryId", "requestId", "traceId"]
  },
  "wake_words": [
    {
      "wake_word_id": "default-xiao-ti",
      "spoken_text": "小T小T",
      "expected_raw": {"keyword": "xiao ti xiao ti"}
    },
    {
      "wake_word_id": "alternate-hey-tcl",
      "spoken_text": "嘿TCL",
      "expected_raw": {"keyword": "hey tcl"}
    }
  ],
  "player_markers": {},
  "health_policy": {
    "NO_WAKEUP": {"threshold": 3, "handling": "snapshot_and_continue", "stop": false},
    "NO_RECOGNITION": {"threshold": 3, "handling": "snapshot_and_session_recovery_continue", "stop": false},
    "PLAYER_FAILURE": {"threshold": 2, "handling": "snapshot_and_continue", "stop": false}
  },
  "observations": {
    "wakeup": {"patterns": [], "final_patterns": []},
    "offline_asr": {"patterns": [], "fields": ["keyword", "intent"]},
    "online": {"patterns": [], "result_fields": []}
  }
}
